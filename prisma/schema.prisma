// Prisma schema for the Nwoke Udi Palm Wine Bar (NUPWB) menu + admin CMS.
// Mirrors the SeedCategory / SeedItem / SeedVariant / venueSettings shape supplied by the client.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  DRINK
  FOOD
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  type        CategoryType
  labelPrefix String?
  note        String?
  position    Int      @default(0)
  hidden      Boolean  @default(false)
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, position])
}

model Item {
  id               String    @id @default(cuid())
  name             String
  description      String?
  featured         Boolean   @default(false)
  available        Boolean   @default(true)
  todoConfirmPrice Boolean   @default(false)
  position         Int       @default(0)
  imagePath        String?
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId       String
  variants         Variant[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId, position])
}

model Variant {
  id          String   @id @default(cuid())
  label       String?
  priceMinor  Int
  position    Int      @default(0)
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([itemId, position])
}

/// Key/value store for venue settings (venue details, hours, socials, map, menu slug).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Single-admin-account model — matches the design spec's "Single admin account" posture.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
